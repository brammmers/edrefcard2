# Ensure shell scripts always have LF line endings (not CRLF)
# This prevents the "no such file or directory" error on Docker/Linux
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Python and text files: normalize to LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary files: no conversion
*.jpg binary
*.png binary
*.pdf binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
