# Admin Panel Credentials
EDREFCARD_ADMIN_USER=admin
EDREFCARD_ADMIN_PASS=changeme

# =============================================================================
# Application Environment
# =============================================================================
# Controls environment-specific behavior (automatic backups, verbose logging, etc.)
# Values: development, staging, production
# Default: development (safe mode - no automatic tasks)
APP_ENV=development

# Flask Configuration
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-secret-key-change-in-production
# FLASK_APP=www/app.py
# FLASK_DEBUG=1

# ImageMagick Configuration (Linux)
# If ImageMagick is installed in a non-standard location or if using a specific version
# MAGICK_HOME=/usr
# MAGICK_HOME=/usr/local
# MAGICK_HOME=/opt/imagemagick

# Application Configuration (Optional overrides)
# CONTEXT_DOCUMENT_ROOT=/var/www/edrefcard
# SCRIPT_URI=https://edrefcard.info/

# Persistence Configuration
# This MUST match the path inside the container where the volume is mounted.
# In docker-compose.yml, we mount: ./configs:/app/www/configs
EDREFCARD_CONFIGS_DIR=/app/www/configs

# Base URL (used for generating links)
APP_URL=http://localhost:8080

# =============================================================================
# Backup System Configuration
# =============================================================================
# All backup settings (SFTP, scheduling, Discord webhook) are configured 
# via the Admin Panel UI at /admin/backup/settings.
# SFTP password is stored encrypted in the database for security.
#
# The automatic backup scheduler only runs when APP_ENV=production AND
# auto_backup_enabled is set to True in the admin settings.
